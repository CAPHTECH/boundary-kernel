{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caph.tech/schemas/rbk.decision.v2.schema.json",
  "title": "Review Boundary Decision v2",
  "description": "境界計算の出力。routing(三値の outcome)と measurement(basis_complete)の二軸、それを導いた factor 別の根拠、および同一性(帰属のための digest 群)。v1 からの破壊的変更: basis_complete を decision と factorVerdict の双方に必須で追加した。v1 は routing と measurement を単一の値に畳んでおり、human_required と incomplete が同時に立つ状態を表現できなかった(設計 §3)。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "request_id",
    "policy_id",
    "outcome",
    "basis_complete",
    "factors",
    "identity",
    "computed_at"
  ],
  "properties": {
    "schema": { "const": "rbk.decision.v2" },

    "decision_id": {
      "description": "hash(action_digest, evidence_state_digest, policy_id, policy_version)。policy を含むため、policy 変更は新しい decision を生む。",
      "$ref": "#/$defs/hash"
    },
    "request_id": { "$ref": "#/$defs/identifier" },
    "policy_id": { "$ref": "#/$defs/identifier" },
    "policy_version": { "$ref": "#/$defs/semver" },

    "outcome": {
      "description": "routing 軸 — この行為をどこへ回すか。incomplete を human_required に潰してはならない。集計時も別カウントを維持する。",
      "enum": ["auto_apply", "human_required", "incomplete"]
    },

    "basis_complete": {
      "description": "measurement 軸 — 我々の証拠基盤は十分だったか。いずれかの factor が incomplete 信号を1つでも出したら false。outcome が human_required でも false になりうる(むしろそれが v1 で失われていた情報)。outcome == incomplete は、basis_complete == false かつ human_required の factor が無い場合と厳密に一致する。",
      "type": "boolean"
    },

    "granted_dimensions": {
      "description": "【集合】outcome=auto_apply のとき、非人間アクターに認められた agency 次元。正準順は GAE ベクトル順 ⟨O,F,P,J,U,E,L⟩。要求された次元の部分集合であり、上回ることはない(単調な狭まり)。",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/agencyDimension" }
    },

    "withheld_dimensions": {
      "description": "【集合】要求されたが認められなかった次元 = requested − granted。正準順は GAE ベクトル順。authority 以外の factor が閉じた場合も、認められた次元は無いのでここに全要求次元が入る。空でない場合、outcome は auto_apply にならない。",
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/agencyDimension" }
    },

    "factors": {
      "description": "【集合】factor 種別で一意。全 factor を必ず列挙する(6種)。満たされた factor も省略しない(欠損と満足を区別できなくなるため)。正準順は factor enum 順。",
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/factorVerdict" }
    },

    "identity": {
      "description": "決定の同一性。evidence_state_digest は policy を含まない — この分離が原因帰属を可能にする。",
      "type": "object",
      "additionalProperties": false,
      "required": ["action_digest", "evidence_state_digest"],
      "properties": {
        "action_digest": { "$ref": "#/$defs/hash" },
        "evidence_state_digest": { "$ref": "#/$defs/hash" }
      }
    },

    "attribution": {
      "description": "先行 decision と比較した場合のみ存在する。変化原因を切り分けられない場合は unattributable とし、単一原因として提示しない。",
      "type": "object",
      "additionalProperties": false,
      "required": ["compared_to_decision_id", "cause"],
      "properties": {
        "compared_to_decision_id": { "$ref": "#/$defs/hash" },
        "cause": {
          "enum": ["action_change", "evidence_change", "policy_change", "unattributable", "no_change"]
        },
        "changed_components": {
          "description": "【集合】正準順は enum 宣言順。",
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["action_digest", "evidence_state_digest", "policy_id", "policy_version"] }
        },
        "outcome_transition": {
          "description": "注目すべき遷移: auto_apply → human_required は境界が締まったことを、逆は緩んだことを意味する。後者は policy_change 以外の原因なら要調査。",
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "enum": ["auto_apply", "human_required", "incomplete"] },
            "to": { "enum": ["auto_apply", "human_required", "incomplete"] }
          }
        }
      }
    },

    "routing": {
      "description": "ホストへの助言。カーネルは実行しない。",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_evidence_modes": {
          "description": "【集合】基盤の欠損を解消するために必要な証拠の種別。「次に何を観測すべきか」を必ず返す。正準順はコード単位昇順。",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "escalate_to": {
          "description": "エスカレーション先。カーネルはこれを導出しない(policy にも request にも先を決める情報が無い)。ホストが自身の組織構造に基づいて後から埋めるフィールドである。",
          "type": "string"
        }
      }
    },

    "computed_at": { "type": "string", "format": "date-time" },
    "kernel_version": { "$ref": "#/$defs/semver" }
  },

  "allOf": [
    {
      "$comment": "基盤が欠けているなら「次に何を観測すべきか」を必ず返す。outcome が human_required でも同じ — 返せないなら欠損を報告したことにならない。",
      "if": {
        "required": ["basis_complete"],
        "properties": { "basis_complete": { "const": false } }
      },
      "then": {
        "required": ["routing"],
        "properties": {
          "routing": {
            "required": ["required_evidence_modes"],
            "properties": { "required_evidence_modes": { "minItems": 1 } }
          }
        }
      }
    },
    {
      "$comment": "auto_apply なら保留された次元は存在せず(単調な狭まりの帰結)、基盤も完全である。",
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "auto_apply" } }
      },
      "then": {
        "properties": {
          "withheld_dimensions": { "maxItems": 0 },
          "basis_complete": { "const": true }
        }
      }
    },
    {
      "$comment": "不変条件(→): outcome == incomplete ⟹ basis_complete == false かつ human_required な factor は無い。",
      "if": {
        "required": ["outcome"],
        "properties": { "outcome": { "const": "incomplete" } }
      },
      "then": {
        "properties": {
          "basis_complete": { "const": false },
          "factors": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["verdict"],
                "properties": { "verdict": { "const": "human_required" } }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "不変条件(←): basis_complete == false かつ human_required な factor が無いなら、outcome は incomplete でなければならない。",
      "if": {
        "type": "object",
        "required": ["basis_complete", "factors"],
        "properties": {
          "basis_complete": { "const": false },
          "factors": {
            "not": {
              "contains": {
                "type": "object",
                "required": ["verdict"],
                "properties": { "verdict": { "const": "human_required" } }
              }
            }
          }
        }
      },
      "then": {
        "properties": { "outcome": { "const": "incomplete" } }
      }
    },
    {
      "$comment": "decision の basis_complete は factor の basis_complete の連言である(→)。",
      "if": {
        "required": ["factors"],
        "properties": {
          "factors": {
            "contains": {
              "type": "object",
              "required": ["basis_complete"],
              "properties": { "basis_complete": { "const": false } }
            }
          }
        }
      },
      "then": {
        "properties": { "basis_complete": { "const": false } }
      }
    },
    {
      "$comment": "同(←): 基盤が欠けていると言うなら、そう言った factor が存在しなければならない。",
      "if": {
        "required": ["basis_complete"],
        "properties": { "basis_complete": { "const": false } }
      },
      "then": {
        "properties": {
          "factors": {
            "contains": {
              "type": "object",
              "required": ["basis_complete"],
              "properties": { "basis_complete": { "const": false } }
            }
          }
        }
      }
    }
  ],

  "$defs": {
    "identifier": { "type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9._:-]*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "hash": { "type": "string", "pattern": "^(sha256|blake3):[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "agencyDimension": {
      "enum": ["observe", "frame", "project", "judge", "authorize", "execute", "learn"]
    },

    "factorVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["factor", "verdict", "basis_complete", "reasons"],
      "properties": {
        "factor": {
          "enum": ["applicability", "authority", "evidence", "freshness", "risk", "reversibility"]
        },
        "verdict": {
          "description": "routing 軸。satisfied 以外は必ず reasons を伴う。理由のない制限を出力してはならない。",
          "enum": ["satisfied", "human_required", "incomplete"]
        },
        "basis_complete": {
          "description": "measurement 軸。この factor が incomplete 信号を1つでも出したら false。verdict=human_required と basis_complete=false は同時に立ちうる — その factor が「人間が決めるべき」と「証拠基盤も欠けている」の両方を報告した場合であり、後者を reasons のテキストに埋めて捨ててはならない。",
          "type": "boolean"
        },
        "reasons": {
          "description": "【順序付き】カーネルが検出した順。順序それ自体が根拠の提示順であり、正規化しない。",
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "evidence_ids": {
          "description": "【集合】この判定が参照した証拠。正準順は evidence_id 昇順。空であることは「参照する証拠が無かった」を意味する。",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "$comment": "理由のない制限を出力してはならない(設計 §4)。satisfied 以外は reasons が必須。",
          "if": {
            "required": ["verdict"],
            "properties": { "verdict": { "not": { "const": "satisfied" } } }
          },
          "then": {
            "properties": { "reasons": { "minItems": 1 } }
          }
        },
        {
          "$comment": "verdict=incomplete なら基盤は必ず欠けている(逆は成り立たない)。",
          "if": {
            "required": ["verdict"],
            "properties": { "verdict": { "const": "incomplete" } }
          },
          "then": {
            "properties": { "basis_complete": { "const": false } }
          }
        },
        {
          "$comment": "基盤が欠けている factor は理由を述べなければならない。",
          "if": {
            "required": ["basis_complete"],
            "properties": { "basis_complete": { "const": false } }
          },
          "then": {
            "properties": { "reasons": { "minItems": 1 } }
          }
        }
      ]
    }
  }
}
